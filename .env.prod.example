# Copia a .env.prod a la NAS i canvia TOTS els valors marcats amb CANVIA
# Genera secrets amb:  python -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_USER=geomap
POSTGRES_PASSWORD=CANVIA-contrasenya-llarga
POSTGRES_DB=geomap
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
API_SECRET_KEY=CANVIA-secret-jwt

# Port local on escolta nginx (el que apuntaràs des del proxy invers de DSM o el túnel)
WEB_PORT=8080

# Només cal si el frontend es serveix des d'un altre domini (amb nginx no cal)
CORS_ORIGINS=

# Memòria. Valors per a 2 GB de RAM; amb 6 GB: PG_SHARED_BUFFERS=512MB,
# PG_EFFECTIVE_CACHE_SIZE=2GB, DB_MEM_LIMIT=2g, API_MEM_LIMIT=1g, API_WORKERS=2
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
DB_MEM_LIMIT=1g
API_MEM_LIMIT=768m
API_WORKERS=1
IMPORT_MEM_LIMIT=512m
CLASSIFY_BATCH=5000

# Hora (UTC) de la importació diària NDVI. El workflow de GitHub s'executa a les 05:00 UTC
IMPORT_HOUR_UTC=8

# Opcional: token del túnel de Cloudflare (Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
